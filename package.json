{
  "name": "carrier-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retrieve policy documents (ID cards first) from insurance carrier portals.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build -w packages/mock-portal && npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run build -w apps/web && npm run build -w packages/mock-portal && npm run build -w apps/server",
    "start": "node apps/server/dist/index.js",
    "spike": "npm run spike -w apps/server --",
    "live-login": "npm run live-login -w apps/server --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darenceT/carrier-docs.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
