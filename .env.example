# Copy to .env for local runs. Use DIFFERENT values from the ones on Render.
# Generate real values with the PowerShell snippets in the build guide (Phase 0).
PORT=3000
DATA_DIR=./data
# 32 random bytes, base64 (AES-256-GCM key; also signs cookies)
SESSION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# Shared access code for reviewers
ACCESS_CODE=local-dev-access-code
# Protects /internal/canary and /internal/spike
CANARY_TOKEN=local-dev-canary-token
MAX_SESSIONS=3
IDLE_TIMEOUT_S=180
MFA_TIMEOUT_S=300
PREWARM_TIMEOUT_S=120
SESSION_TTL_DAYS=7
DEMO_CARRIER_ENABLED=true
PROGRESSIVE_BROWSER=patched-headless
CARRIER2_BROWSER=patched-headless
LOG_LEVEL=info
