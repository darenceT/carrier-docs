# Copy to .env for local runs: `cp .env.example .env && docker compose up` works as is.
# The three secrets below are public local-only values; the server refuses them on Render.
# Generate real ones for Render with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORT=3000
DATA_DIR=./data
# 32 random bytes, base64 (AES-256-GCM key; also signs cookies)
SESSION_KEY=bG9jYWwtZGV2LW9ubHkta2V5LW5vdC1hLXNlY3JldCE=
# Shared access code for reviewers
ACCESS_CODE=local-dev-access-code
# Protects /internal/canary and /internal/spike
CANARY_TOKEN=local-dev-canary-token
# Login pages the canary loads: demo, progressive, lemonade. Keep demo locally.
CANARY_CARRIERS=demo
MAX_SESSIONS=1
QUEUE_WAIT_S=30
DOCUMENT_CACHE_S=600
MFA_TIMEOUT_S=300
PREWARM_TIMEOUT_S=120
SESSION_TTL_DAYS=7
DEMO_CARRIER_ENABLED=true
PROGRESSIVE_BROWSER=patched-headless
CARRIER2_BROWSER=patched-headless
LOG_LEVEL=info
