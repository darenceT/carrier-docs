# Packages may not run install scripts. better-sqlite3 ships prebuilt binaries (linux-x64,
# win32-x64, ...) but npm would still compile it from source because it has a binding.gyp,
# which needs python and a C++ toolchain. This also blocks install-time code from dependencies.
# `npm run`, `npm test` etc. still run the scripts you ask for.
ignore-scripts=true
